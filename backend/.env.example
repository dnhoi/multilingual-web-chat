# ==========================================
# MULTILINGUAL WEB CHAT SYSTEM (.env.example)
# ==========================================

# ------------------------------------------
# DATABASE CONFIGURATION (MySQL)
# ------------------------------------------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=multilingual_chat
MYSQL_USER=chatuser
MYSQL_PASSWORD=chatpassword
URL_DB=jdbc:mysql://localhost:3306/multilingual_chat?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
USERNAME_DB=root
PASSWORD_DB=rootpassword

# ------------------------------------------
# REDIS CONFIGURATION
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme_in_production

# ------------------------------------------
# SECURITY & JWT CONFIGURATION
# ------------------------------------------
# Generates secret via openssl rand -base64 64
SIGNER_KEY=1234567890123456789012345678901234567890123456789012345678901234

# ------------------------------------------
# GOOGLE OAUTH2 CREDENTIALS
# ------------------------------------------
CLIENT_ID=your-google-oauth2-client-id.apps.googleusercontent.com
CLIENT_SECRET=your-google-oauth2-client-secret

# ------------------------------------------
# THIRD-PARTY SERVICES & TRANSLATION
# ------------------------------------------
BREVO_API_KEY=your_brevo_api_key
TRANSLATE_URL=https://api.mymemory.translated.net/get
IDENTIFY_URL=http://localhost:8080/identify

# ------------------------------------------
# SYSTEM & APPLICATION DEFAULTS
# ------------------------------------------
FRONTEND_URL=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword
COOKIE_SECURE=false
