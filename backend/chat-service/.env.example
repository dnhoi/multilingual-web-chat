# ==========================================
# CHAT-SERVICE CONFIGURATION (.env.example)
# ==========================================

# Database Connection
URL_DB=jdbc:mysql://localhost:3306/multilingual_chat?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
USERNAME_DB=root
PASSWORD_DB=rootpassword

# External Translation API URL
TRANSLATE_URL=https://api.mymemory.translated.net/get

# Inter-service Identify Service URL
IDENTIFY_URL=http://localhost:8080/identify

# JWT Signing Key (Must match identify-service)
SIGNER_KEY=1234567890123456789012345678901234567890123456789012345678901234
