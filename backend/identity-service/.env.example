# ==========================================
# IDENTIFY-SERVICE CONFIGURATION (.env.example)
# ==========================================

# Database Connection
URL_DB=jdbc:mysql://localhost:3306/multilingual_chat?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
USERNAME_DB=root
PASSWORD_DB=rootpassword

# Redis Authentication
REDIS_PASSWORD=changeme_in_production

# JWT Signing Key (Must match across microservices)
SIGNER_KEY=1234567890123456789012345678901234567890123456789012345678901234

# Google OAuth2 Setup
CLIENT_ID=your-google-oauth2-client-id.apps.googleusercontent.com
CLIENT_SECRET=your-google-oauth2-client-secret

# Email Service (Brevo / SendGrid)
BREVO_API_KEY=your_brevo_api_key

# Application Settings
FRONTEND_URL=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword
COOKIE_SECURE=false
